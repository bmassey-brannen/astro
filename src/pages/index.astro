---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import FormattedDate from "../components/FormattedDate.astro";

const posts = await getCollection("blog");

const sortedPosts = posts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate);
  const dateB = new Date(b.data.pubDate);
  return dateB.getTime() - dateA.getTime();
});

const pinnedSlug = "how-i-think-about-leaps-and-diagonal-calls";
const pinnedPost = sortedPosts.find((post) => post.slug === pinnedSlug) ?? sortedPosts[0];
const recentPosts = sortedPosts
  .filter((post) => post.slug !== pinnedPost?.slug)
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0M58B909ZC"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-0M58B909ZC");
    </script>
    <style>
      main {
        max-width: 1080px;
        padding: 0 1.25rem 4rem;
        width: 100%;
      }

      .hero {
        display: grid;
        gap: 1.2rem;
        grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
        align-items: start;
        margin: 1.65rem auto 2.15rem;
      }

      .hero-copy {
        border-radius: 28px;
        padding: clamp(1.25rem, 3vw, 2rem);
      }

      .eyebrow {
        color: var(--accent-warm);
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.14em;
        margin-bottom: 0.85rem;
        text-transform: uppercase;
      }

      .hero h1 {
        font-size: clamp(2.35rem, 5.1vw, 3.95rem);
        letter-spacing: -0.045em;
        line-height: 1;
        margin-bottom: 1rem;
        max-width: 680px;
        text-wrap: balance;
      }

      .hero-lede {
        color: rgb(var(--ink-muted));
        font-size: clamp(1.04rem, 1.8vw, 1.2rem);
        line-height: 1.55;
        max-width: 680px;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 1.25rem;
      }

      .button {
        align-items: center;
        border-radius: 999px;
        display: inline-flex;
        font-weight: 800;
        line-height: 1;
        padding: 0.85rem 1.1rem;
        text-decoration: none;
      }

      .button.primary {
        background: linear-gradient(135deg, #c89b5f, #8f6836);
        box-shadow: 0 14px 34px rgba(200, 155, 95, 0.18);
        color: white;
      }

      .button.secondary {
        background: rgba(255, 255, 255, 0.055);
        border: 1px solid rgba(238, 243, 246, 0.14);
        color: rgb(var(--ink));
      }

      .portrait-card {
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.105), rgba(255, 255, 255, 0.035)),
          var(--glass-bg);
        backdrop-filter: blur(18px) saturate(125%);
        -webkit-backdrop-filter: blur(18px) saturate(125%);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        box-shadow: var(--glass-shadow);
        margin: 0;
        overflow: hidden;
        max-width: 340px;
        justify-self: end;
      }

      .portrait-card img {
        aspect-ratio: 1 / 1;
        display: block;
        object-fit: cover;
        width: 100%;
      }

      .portrait-card figcaption {
        color: rgb(var(--ink-muted));
        font-size: 0.9rem;
        line-height: 1.45;
        padding: 0.85rem 1rem 1rem;
      }

      .section-heading {
        align-items: end;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        margin: 2.35rem 0 1rem;
      }

      .section-heading h2 {
        margin: 0;
      }

      .section-heading a {
        font-weight: 800;
      }

      .focus-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .focus-card,
      .feature-card,
      .post-card {
        background:
          linear-gradient(145deg, rgba(255, 255, 255, 0.105), rgba(255, 255, 255, 0.035)),
          var(--glass-bg);
        backdrop-filter: blur(18px) saturate(125%);
        -webkit-backdrop-filter: blur(18px) saturate(125%);
        border: 1px solid var(--glass-border);
        border-radius: 22px;
        box-shadow: var(--glass-shadow);
        transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
      }

      .focus-card:hover,
      .feature-card:hover,
      .post-card:hover {
        border-color: rgba(200, 155, 95, 0.28);
        box-shadow: 0 26px 76px rgba(0, 0, 0, 0.42), 0 0 34px rgba(200, 155, 95, 0.08);
        transform: translateY(-2px);
      }

      .focus-card {
        padding: 1.15rem;
      }

      .focus-card h3 {
        font-size: 1.25rem;
        margin-top: 0;
      }

      .focus-card p {
        color: rgb(var(--ink-muted));
        font-size: 0.98rem;
        line-height: 1.55;
        margin-bottom: 0;
      }

      .feature-card {
        display: grid;
        gap: 1.25rem;
        grid-template-columns: minmax(240px, 0.9fr) minmax(0, 1.1fr);
        overflow: hidden;
      }

      .feature-card img,
      .post-card img {
        display: block;
        width: 100%;
      }

      .feature-card img {
        aspect-ratio: 16 / 9;
        background: #0c1118;
        height: 100%;
        object-fit: contain;
      }

      .feature-content {
        padding: 1.25rem 1.25rem 1.25rem 0;
      }

      .pin-label {
        color: var(--accent);
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 900;
        letter-spacing: 0.14em;
        margin-bottom: 0.35rem;
        text-transform: uppercase;
      }

      .feature-content h3 {
        font-size: clamp(1.55rem, 3vw, 2.15rem);
        margin-top: 0.4rem;
      }

      .date {
        color: rgb(var(--ink-muted));
        font-size: 0.9rem;
        font-weight: 700;
      }

      .post-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .post-card {
        overflow: hidden;
      }

      .post-card img {
        aspect-ratio: 16 / 9;
        background: #f4f1dc;
        height: auto;
        object-fit: cover;
      }

      .post-card-content {
        padding: 1rem;
      }

      .post-card h3 {
        font-size: 1.15rem;
        margin: 0.35rem 0 0.65rem;
      }

      .post-card a,
      .feature-card a {
        color: inherit;
        text-decoration: none;
      }

      .post-card a:hover,
      .feature-card a:hover {
        color: #f0c989;
      }

      .mini-note {
        color: rgb(var(--ink-muted));
        font-size: 0.95rem;
      }

      @media (max-width: 860px) {
        .hero,
        .feature-card,
        .focus-grid,
        .post-grid {
          grid-template-columns: 1fr;
        }

        .feature-content {
          padding: 0 1.15rem 1.2rem;
        }

        .portrait-card {
          justify-self: stretch;
          max-width: none;
        }

        .portrait-card img {
          aspect-ratio: 16 / 10;
        }
      }

      @media (max-width: 560px) {
        main {
          padding-inline: 0.85rem;
        }

        .eyebrow {
          font-size: 0.68rem;
          letter-spacing: 0.16em;
          margin-bottom: 0.55rem;
        }

        .hero h1 {
          font-size: clamp(1.95rem, 9vw, 2.55rem);
          margin-bottom: 0.75rem;
        }

        .hero-lede {
          font-size: 0.96rem;
          line-height: 1.5;
        }

        .hero-actions {
          gap: 0.55rem;
          margin-top: 0.95rem;
        }

        .button {
          font-size: 0.92rem;
          padding: 0.72rem 0.9rem;
        }

        .section-heading {
          align-items: start;
          flex-direction: column;
        }

        .hero {
          gap: 1rem;
          margin-top: 0.85rem;
        }

        .portrait-card {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <Header title={SITE_TITLE} />
    <main>
      <section class="hero">
        <div class="hero-copy glass-panel">
          <p class="eyebrow">Operator journal · Project notebook</p>
          <h1>Hi, I’m Ben.</h1>
          <p class="hero-lede">
            I build websites, dashboards, and small tools to understand messy
            systems: markets, public records, local projects, data, and the
            occasional personal experiment that gets out of hand. This site is
            where I keep the notes, receipts, mistakes, and build logs.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="/blog/">Read the journal</a>
            <a class="button secondary" href="/about/">About me</a>
          </div>
        </div>

        <figure class="portrait-card">
          <img src="/bmbrun.jpg" alt="Ben Brannen running" />
          <figcaption>
            Runner, dashboard tinkerer, market-note hoarder, and serial starter
            of projects that turn into systems.
          </figcaption>
        </figure>
      </section>

      <section aria-labelledby="focus-heading">
        <div class="section-heading">
          <h2 id="focus-heading">What shows up here</h2>
        </div>
        <div class="focus-grid">
          <article class="focus-card">
            <h3>Build logs</h3>
            <p>
              Websites, dashboards, scripts, and tools I built because a system
              was too scattered, too manual, or too annoying to leave alone.
            </p>
          </article>
          <article class="focus-card">
            <h3>Markets and mistakes</h3>
            <p>
              Notes on stocks, options, research structure, decision logs, and
              the trading lessons I do not want to pay for twice.
            </p>
          </article>
          <article class="focus-card">
            <h3>Public records and local data</h3>
            <p>
              Field notes from following paperwork, entities, incentives, meeting
              minutes, property records, and the tools that make them usable.
            </p>
          </article>
        </div>
      </section>

      {
        pinnedPost && (
          <section aria-labelledby="featured-heading">
            <div class="section-heading">
              <h2 id="featured-heading">Pinned post</h2>
              <a href="/blog/">All posts →</a>
            </div>
            <article class="feature-card">
              <a href={`/blog/${pinnedPost.slug}/`}>
                {pinnedPost.data.heroImage && (
                  <img
                    src={pinnedPost.data.heroImage}
                    alt={pinnedPost.data.title}
                    loading="eager"
                  />
                )}
              </a>
              <div class="feature-content">
                <span class="pin-label">Options structure note</span>
                <div class="date">
                  <FormattedDate date={pinnedPost.data.pubDate} />
                </div>
                <h3>
                  <a href={`/blog/${pinnedPost.slug}/`}>
                    {pinnedPost.data.title}
                  </a>
                </h3>
                <p>{pinnedPost.data.description}</p>
                <a class="button secondary" href={`/blog/${pinnedPost.slug}/`}>
                  Read the pinned post
                </a>
              </div>
            </article>
          </section>
        )
      }

      <section aria-labelledby="recent-heading">
        <div class="section-heading">
          <h2 id="recent-heading">Recent notes</h2>
          <a href="/blog/">Browse the archive →</a>
        </div>
        <div class="post-grid">
          {
            recentPosts.map((post) => (
              <article class="post-card">
                <a href={`/blog/${post.slug}/`}>
                  {post.data.heroImage && (
                    <img
                      src={post.data.heroImage}
                      alt={post.data.title}
                      loading="eager"
                    />
                  )}
                </a>
                <div class="post-card-content">
                  <div class="date">
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                  <h3>
                    <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                  </h3>
                  <p class="mini-note">{post.data.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
