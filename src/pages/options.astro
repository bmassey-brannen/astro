---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Options Strategy Lab | Ben Brannen";
const description = "A public-safe, read-only options strategy workbook for understanding payoff shape, risk, breakeven, and structure tradeoffs.";

const strategies = [
  {
    id: "long-call",
    name: "Long Call",
    tone: "Aggressively bullish? Defined downside, uncapped upside if the move arrives.",
    summary:
      "A long call is the cleanest convex expression: premium at risk, upside if the underlying clears the strike and keeps moving. It is simple, but timing and IV can still punish sloppy entries.",
    steps: [
      "Choose an expiration that gives the thesis room to breathe.",
      "Set a strike where the move would make the option matter.",
      "Premium paid is the maximum modeled loss at expiration.",
      "Breakeven is strike plus premium. Above that, the payoff keeps expanding."
    ],
    walk: "The point is not to predict every wiggle. The point is to know what price has to be true before the option stops being a lottery ticket and starts behaving like owned convexity.",
    cap: "Uncapped",
    maxLoss: "Premium paid"
  },
  {
    id: "bull-call-spread",
    name: "Bull Call Spread",
    tone: "Moderately bullish? Lower cost, but the ceiling is real.",
    summary:
      "A bull call spread reduces the upfront debit by pairing a lower-strike long call with a higher-strike short call. The tradeoff is simple: cheaper exposure, capped upside.",
    steps: [
      "Model the lower strike as the engine of the trade.",
      "Use the upper strike as the cap, not as free money.",
      "Net debit is lower than a standalone long call.",
      "Maximum profit is spread width minus net debit. Above the upper strike, gains stop."
    ],
    walk: "This structure fits a defined target better than a miracle. It can finance the thesis, but it can also handcuff the thesis if the move gets violent.",
    cap: "Capped",
    maxLoss: "Net debit"
  },
  {
    id: "long-put",
    name: "Long Put",
    tone: "Bearish or hedge-focused? Defined risk, downside torque.",
    summary:
      "A long put gains value when the underlying falls below the strike enough to overcome premium. It can express a downside thesis or protect risk, but decay is still the rent.",
    steps: [
      "Start with the failure thesis, not fear.",
      "Pick an expiration that matches the catalyst window.",
      "Premium paid is the maximum modeled loss at expiration.",
      "Breakeven is strike minus premium. Below that, payoff expands."
    ],
    walk: "A put should answer a specific downside thesis. If it only answers anxiety, the model is doing therapy instead of structure.",
    cap: "Limited by zero",
    maxLoss: "Premium paid"
  },
  {
    id: "covered-call",
    name: "Covered Call",
    tone: "Income against shares? Useful plumbing, dangerous handcuffs.",
    summary:
      "A covered call collects premium against owned shares. It can reduce basis, but it also sells part of the upside above the short strike.",
    steps: [
      "Confirm the shares are already owned in the scenario.",
      "Set the short strike where giving up upside is acceptable.",
      "Premium cushions downside by a limited amount.",
      "Above the strike, the position is capped and assignment risk exists."
    ],
    walk: "The trap is treating income like progress while selling away the move you were waiting for. Financing is plumbing. It is not the thesis.",
    cap: "Capped above strike",
    maxLoss: "Share downside minus premium"
  },
  {
    id: "straddle",
    name: "Long Straddle",
    tone: "Expecting violence, unsure direction? The move has to beat the rent.",
    summary:
      "A long straddle uses a call and put at the same strike. It needs a large move in either direction because two premiums have to be overcome.",
    steps: [
      "Use when direction is unclear but magnitude matters.",
      "Premium stack is the max modeled loss at expiration.",
      "Upper breakeven is strike plus total premium.",
      "Lower breakeven is strike minus total premium."
    ],
    walk: "This is a volatility bet. If the underlying sits still after the event, the structure bleeds even if the story felt important.",
    cap: "Uncapped up / limited down",
    maxLoss: "Total premium"
  },
  {
    id: "iron-condor",
    name: "Iron Condor",
    tone: "Expecting a range? Collect premium, accept defined tail risk.",
    summary:
      "An iron condor expresses a range-bound thesis with defined-risk spreads on both sides. It works when the underlying stays inside the body of the structure.",
    steps: [
      "Define the expected range first.",
      "Set short strikes outside the range you think holds.",
      "Long wings define max loss.",
      "The structure loses when price breaks out beyond either side."
    ],
    walk: "Range structures are not sleepy if the underlying wakes up. They demand humility about catalysts, gaps, and hidden volatility.",
    cap: "Premium capped",
    maxLoss: "Wing width minus credit"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main.options-lab {
        width: min(1180px, calc(100% - 2rem));
        max-width: none;
        padding: 1.6rem 0 4rem;
      }

      .options-shell {
        overflow: hidden;
        border: 1px solid rgba(238, 243, 246, 0.13);
        border-radius: 30px;
        background:
          linear-gradient(180deg, rgba(255, 252, 244, 0.98), rgba(244, 239, 229, 0.96)),
          #f7f1e7;
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.34);
        color: #182334;
      }

      .options-title {
        padding: clamp(1.35rem, 3vw, 2.2rem) clamp(1.1rem, 3vw, 2.35rem);
        border-bottom: 1px solid rgba(46, 67, 82, 0.12);
        background:
          radial-gradient(circle at 88% 0%, rgba(47, 112, 184, 0.14), transparent 20rem),
          linear-gradient(180deg, #fffaf0, #f4ebdd);
      }

      .options-title .eyebrow {
        margin: 0 0 0.45rem;
        color: #2f70b8;
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .options-title h1 {
        max-width: 780px;
        margin: 0;
        color: #153455;
        font-size: clamp(2.25rem, 5vw, 4rem);
        letter-spacing: -0.055em;
        line-height: 0.97;
      }

      .options-title p {
        max-width: 760px;
        margin: 0.8rem 0 0;
        color: #596879;
        font-size: clamp(1rem, 1.5vw, 1.14rem);
        line-height: 1.55;
      }

      .lab-grid {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        min-height: 760px;
      }

      .lab-sidebar {
        padding: 1.2rem;
        border-right: 1px solid rgba(46, 67, 82, 0.12);
        background:
          linear-gradient(180deg, rgba(248, 250, 252, 0.95), rgba(236, 242, 247, 0.88)),
          #f8fafc;
      }

      .lab-sidebar section + section {
        margin-top: 1.35rem;
      }

      .section-label {
        margin: 0 0 0.65rem;
        color: #667789;
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .strategy-list {
        display: grid;
        gap: 0.48rem;
      }

      .strategy-button {
        width: 100%;
        min-height: 42px;
        padding: 0 0.8rem;
        border: 1px solid rgba(132, 148, 166, 0.33);
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
        color: #26384b;
        cursor: pointer;
        font: inherit;
        font-size: 0.86rem;
        font-weight: 850;
        text-align: left;
      }

      .strategy-button.active {
        border-color: #2f70b8;
        background: linear-gradient(180deg, #3b86d2, #2468b2);
        box-shadow: 0 10px 24px rgba(36, 104, 178, 0.18);
        color: #ffffff;
      }

      .ticker-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.55rem;
      }

      .ticker-row input,
      .ticker-row button {
        min-height: 40px;
        border-radius: 12px;
        border: 1px solid rgba(132, 148, 166, 0.33);
        background: #ffffff;
        color: #1f3248;
        font: inherit;
        font-size: 0.86rem;
        font-weight: 850;
      }

      .ticker-row input {
        padding: 0 0.75rem;
        text-transform: uppercase;
      }

      .ticker-row button {
        padding: 0 0.75rem;
        border-color: rgba(47, 112, 184, 0.42);
        background: #eef6ff;
        color: #1f5f9e;
        cursor: pointer;
      }

      .ticker-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.42rem;
        margin-top: 0.65rem;
      }

      .ticker-chip {
        border: 1px solid rgba(47, 112, 184, 0.18);
        border-radius: 999px;
        background: #edf5ff;
        color: #2b659f;
        cursor: pointer;
        font: inherit;
        font-size: 0.72rem;
        font-weight: 900;
        padding: 0.26rem 0.5rem;
      }

      .slider-group {
        display: grid;
        gap: 0.85rem;
      }

      .slider-field label {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: #596879;
        font-size: 0.78rem;
        font-weight: 850;
      }

      .slider-field output {
        color: #17395f;
        font-variant-numeric: tabular-nums;
      }

      input[type="range"] {
        width: 100%;
        accent-color: #2f70b8;
      }

      .sidebar-note {
        border: 1px solid rgba(139, 100, 36, 0.22);
        border-radius: 16px;
        background: rgba(139, 100, 36, 0.08);
        color: #6b562f;
        font-size: 0.76rem;
        font-weight: 800;
        line-height: 1.45;
        padding: 0.8rem;
      }

      .lab-main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(260px, 0.52fr);
        align-content: start;
        gap: 1rem;
        padding: 1.2rem;
      }

      .card {
        border: 1px solid rgba(46, 67, 82, 0.12);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 16px 34px rgba(44, 56, 70, 0.06);
        padding: 1rem;
      }

      .summary-card,
      .payoff-card,
      .disclaimer {
        grid-column: 1 / -1;
      }

      .card h2,
      .card h3 {
        color: #1e2d3d;
        letter-spacing: -0.02em;
        margin: 0 0 0.55rem;
      }

      .card h2 {
        font-size: clamp(1.55rem, 3vw, 2.35rem);
      }

      .card h3 {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.11em;
      }

      .blue-line {
        color: #2f70b8;
        display: block;
        font-size: 1.04rem;
        font-weight: 900;
        line-height: 1.4;
        margin-bottom: 0.6rem;
      }

      .card p,
      .card li,
      .card small {
        color: #596879;
        line-height: 1.55;
      }

      .mechanics-list,
      .walk-list {
        display: grid;
        gap: 0.65rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .mechanics-list li,
      .walk-list li {
        display: flex;
        gap: 0.7rem;
        font-size: 0.9rem;
      }

      .mechanics-list b,
      .walk-list b {
        align-items: center;
        background: #2f70b8;
        border-radius: 999px;
        color: white;
        display: inline-flex;
        flex: 0 0 26px;
        height: 26px;
        justify-content: center;
        line-height: 1;
        width: 26px;
      }

      .key-grid {
        display: grid;
        gap: 0.65rem;
      }

      .key-number {
        border-bottom: 1px solid rgba(46, 67, 82, 0.12);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.58rem;
      }

      .key-number:last-child {
        border-bottom: 0;
        padding-bottom: 0;
      }

      .key-number span {
        color: #708093;
        font-size: 0.75rem;
        font-weight: 850;
        text-transform: uppercase;
      }

      .key-number b {
        color: #1e2d3d;
        font-variant-numeric: tabular-nums;
        text-align: right;
      }

      .payoff-card {
        min-height: 330px;
      }

      .payoff-header {
        align-items: baseline;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.65rem;
      }

      .payoff-header h3 {
        margin: 0;
      }

      .payoff-header span {
        color: #708093;
        font-size: 0.78rem;
        font-weight: 850;
      }

      .payoff-chart {
        display: block;
        height: 290px;
        width: 100%;
      }

      .scenario-grid {
        display: grid;
        gap: 0.7rem;
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .scenario {
        border: 1px solid rgba(46, 67, 82, 0.11);
        border-radius: 16px;
        background: #fffaf3;
        padding: 0.8rem;
      }

      .scenario span,
      .scenario small {
        display: block;
      }

      .scenario span {
        color: #708093;
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .scenario b {
        color: #1e2d3d;
        display: block;
        font-size: 1.05rem;
        margin: 0.15rem 0;
      }

      .scenario small {
        color: #596879;
        font-size: 0.78rem;
        line-height: 1.35;
      }

      .disclaimer {
        align-items: center;
        border-color: rgba(139, 100, 36, 0.24);
        background: rgba(139, 100, 36, 0.08);
        color: #6b562f;
        display: flex;
        gap: 0.7rem;
        font-size: 0.84rem;
        font-weight: 850;
      }

      .axis-label {
        fill: #718093;
        font-size: 11px;
      }

      .profit-zone {
        fill: rgba(73, 111, 56, 0.12);
      }

      .loss-zone {
        fill: rgba(154, 63, 50, 0.10);
      }

      .payoff-line {
        fill: none;
        stroke: #2f70b8;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 5;
      }

      .zero-line {
        stroke: rgba(46, 67, 82, 0.25);
        stroke-width: 2;
      }

      .marker-line {
        stroke: rgba(139, 100, 36, 0.62);
        stroke-dasharray: 6 6;
        stroke-width: 2;
      }

      @media (max-width: 940px) {
        .lab-grid,
        .lab-main {
          grid-template-columns: 1fr;
        }

        .lab-sidebar {
          border-right: 0;
          border-bottom: 1px solid rgba(46, 67, 82, 0.12);
        }

        .scenario-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 620px) {
        main.options-lab {
          width: min(100% - 0.8rem, 1180px);
        }

        .options-shell {
          border-radius: 22px;
        }

        .scenario-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="options-lab">
      <section class="options-shell" aria-label="Options strategy workbook">
        <header class="options-title">
          <p class="eyebrow">Options Strategies</p>
          <h1>Structure without the brokerage dopamine.</h1>
          <p>
            A public-safe workbook for understanding option payoff shape, max loss, breakeven,
            capped upside, and the difference between financing a thesis and handcuffing it.
          </p>
        </header>

        <div class="lab-grid">
          <aside class="lab-sidebar" aria-label="Strategy controls">
            <section>
              <p class="section-label">Strategy</p>
              <div class="strategy-list">
                {strategies.map((strategy, index) => (
                  <button class={`strategy-button${index === 0 ? " active" : ""}`} type="button" data-strategy={strategy.id}>
                    {strategy.name}
                  </button>
                ))}
              </div>
            </section>

            <section>
              <p class="section-label">Stock</p>
              <div class="ticker-row">
                <input id="ticker-input" value="OXY" aria-label="Ticker symbol" maxlength="8" />
                <button type="button" id="ticker-apply">Use ticker</button>
              </div>
              <div class="ticker-chips" aria-label="Example tickers">
                {['OXY', 'RKLB', 'GRPN', 'UMC', 'SPY', 'NVDA'].map((ticker) => (
                  <button class="ticker-chip" type="button" data-ticker={ticker}>{ticker}</button>
                ))}
              </div>
            </section>

            <section>
              <p class="section-label">Parameters</p>
              <div class="slider-group">
                <div class="slider-field">
                  <label for="spot-range">Underlying <output id="spot-output">$56.00</output></label>
                  <input id="spot-range" type="range" min="20" max="120" value="56" step="1" />
                </div>
                <div class="slider-field">
                  <label for="lower-range">Lower strike <output id="lower-output">100%</output></label>
                  <input id="lower-range" type="range" min="80" max="130" value="105" step="1" />
                </div>
                <div class="slider-field">
                  <label for="upper-range">Upper strike <output id="upper-output">120%</output></label>
                  <input id="upper-range" type="range" min="95" max="165" value="120" step="1" />
                </div>
                <div class="slider-field">
                  <label for="premium-range">Premium <output id="premium-output">6%</output></label>
                  <input id="premium-range" type="range" min="1" max="25" value="6" step="1" />
                </div>
              </div>
            </section>

            <section class="sidebar-note">
              Read-only model. No account connection. No order ticket. No position sizing. This is structure literacy, not trading instruction.
            </section>
          </aside>

          <section class="lab-main" aria-live="polite">
            <article class="card summary-card">
              <h2 id="strategy-title">Long Call</h2>
              <strong class="blue-line" id="strategy-tone">Aggressively bullish? Defined downside, uncapped upside if the move arrives.</strong>
              <p id="strategy-summary">
                A long call is the cleanest convex expression: premium at risk, upside if the underlying clears the strike and keeps moving.
              </p>
            </article>

            <article class="card">
              <h3>How it works</h3>
              <ul class="mechanics-list" id="mechanics-list">
                {strategies[0].steps.map((step, index) => (
                  <li><b>{index + 1}</b><span>{step}</span></li>
                ))}
              </ul>
            </article>

            <article class="card">
              <h3>Walk me through it</h3>
              <ul class="walk-list">
                <li><b>1</b><span id="walk-line">{strategies[0].walk}</span></li>
                <li><b>2</b><span>Compare payoff shape before you add complexity. A cheaper structure is not automatically a better structure.</span></li>
                <li><b>3</b><span>Keep the decision separate from execution. The model explains behavior; it does not authorize action.</span></li>
              </ul>
            </article>

            <aside class="card">
              <h3>Key numbers</h3>
              <div class="key-grid">
                <div class="key-number"><span>Ticker</span><b id="key-ticker">OXY</b></div>
                <div class="key-number"><span>Lower strike</span><b id="key-lower">$58.80</b></div>
                <div class="key-number"><span>Upper strike</span><b id="key-upper">$67.20</b></div>
                <div class="key-number"><span>Premium</span><b id="key-premium">$3.36</b></div>
                <div class="key-number"><span>Breakeven</span><b id="key-breakeven">$62.16</b></div>
                <div class="key-number"><span>Max loss</span><b id="key-max-loss">Premium paid</b></div>
                <div class="key-number"><span>Upside</span><b id="key-cap">Uncapped</b></div>
              </div>
            </aside>

            <article class="card payoff-card">
              <div class="payoff-header">
                <h3>Payoff at expiration</h3>
                <span>per share · simplified intrinsic model</span>
              </div>
              <svg class="payoff-chart" viewBox="0 0 760 300" role="img" aria-label="Simplified options payoff chart">
                <rect x="54" y="34" width="652" height="218" rx="12" class="loss-zone"></rect>
                <rect x="378" y="34" width="328" height="218" rx="12" class="profit-zone"></rect>
                <line x1="54" x2="706" y1="162" y2="162" class="zero-line"></line>
                <line x1="378" x2="378" y1="34" y2="252" class="marker-line"></line>
                <polyline id="payoff-line" class="payoff-line" points="54,198 250,198 378,162 706,70"></polyline>
                <text x="54" y="278" class="axis-label">Underlying price →</text>
                <text x="16" y="46" class="axis-label" transform="rotate(-90 16 46)">Modeled P/L</text>
                <text id="chart-left" x="58" y="236" class="axis-label">-30%</text>
                <text id="chart-spot" x="362" y="270" class="axis-label">Spot</text>
                <text id="chart-right" x="666" y="236" class="axis-label">+30%</text>
                <text id="chart-breakeven" x="388" y="56" class="axis-label">Breakeven</text>
              </svg>
            </article>

            <section class="scenario-grid summary-card" aria-label="Scenario cards">
              <article class="scenario"><span>Down 20%</span><b id="scenario-down">-$3.36</b><small>Premium at risk if the thesis fails by expiration.</small></article>
              <article class="scenario"><span>At spot</span><b id="scenario-spot">-$3.36</b><small>Static prices usually punish long premium.</small></article>
              <article class="scenario"><span>Breakeven</span><b id="scenario-be">$62.16</b><small>The point where intrinsic value offsets premium.</small></article>
              <article class="scenario"><span>Up 30%</span><b id="scenario-up">+$10.32</b><small>Shows whether the structure keeps or sells the miracle.</small></article>
            </section>

            <section class="card disclaimer">
              <span>ⓘ</span>
              <span>Educational model only. Options involve substantial risk. This page is not financial advice, not a recommendation, and not connected to a broker.</span>
            </section>
          </section>
        </div>
      </section>
    </main>
    <Footer />

    <script define:vars={{ strategies }}>
      const byId = Object.fromEntries(strategies.map((strategy) => [strategy.id, strategy]));
      let active = strategies[0].id;

      const tickerInput = document.querySelector('#ticker-input');
      const spotRange = document.querySelector('#spot-range');
      const lowerRange = document.querySelector('#lower-range');
      const upperRange = document.querySelector('#upper-range');
      const premiumRange = document.querySelector('#premium-range');

      function money(value) {
        return `$${Number(value).toFixed(2)}`;
      }

      function payoffAt(price, strategy, lower, upper, premium) {
        if (strategy.id === 'bull-call-spread') return Math.min(Math.max(0, price - lower), Math.max(0, upper - lower)) - premium;
        if (strategy.id === 'long-put') return Math.max(0, lower - price) - premium;
        if (strategy.id === 'covered-call') return Math.min(price - Number(spotRange.value), upper - Number(spotRange.value)) + premium;
        if (strategy.id === 'straddle') return Math.abs(price - lower) - premium * 2;
        if (strategy.id === 'iron-condor') return price >= lower && price <= upper ? premium : premium - Math.min(Math.abs(price - lower), Math.abs(price - upper), premium * 3);
        return Math.max(0, price - lower) - premium;
      }

      function updateStrategy(id) {
        active = id;
        const strategy = byId[id];
        document.querySelectorAll('.strategy-button').forEach((button) => button.classList.toggle('active', button.dataset.strategy === id));
        document.querySelector('#strategy-title').textContent = strategy.name;
        document.querySelector('#strategy-tone').textContent = strategy.tone;
        document.querySelector('#strategy-summary').textContent = strategy.summary;
        document.querySelector('#walk-line').textContent = strategy.walk;
        document.querySelector('#mechanics-list').innerHTML = strategy.steps.map((step, index) => `<li><b>${index + 1}</b><span>${step}</span></li>`).join('');
        draw();
      }

      function draw() {
        const strategy = byId[active];
        const ticker = String(tickerInput.value || 'OXY').toUpperCase().slice(0, 8);
        tickerInput.value = ticker;
        const spot = Number(spotRange.value);
        const lowerPct = Number(lowerRange.value) / 100;
        const upperPct = Number(upperRange.value) / 100;
        const premiumPct = Number(premiumRange.value) / 100;
        const lower = spot * lowerPct;
        const upper = Math.max(lower + 1, spot * upperPct);
        const premium = spot * premiumPct;
        const breakeven = strategy.id === 'long-put' ? lower - premium : strategy.id === 'straddle' ? lower + premium * 2 : lower + premium;

        document.querySelector('#spot-output').textContent = money(spot);
        document.querySelector('#lower-output').textContent = `${Math.round(lowerPct * 100)}% (${money(lower)})`;
        document.querySelector('#upper-output').textContent = `${Math.round(upperPct * 100)}% (${money(upper)})`;
        document.querySelector('#premium-output').textContent = `${Math.round(premiumPct * 100)}% (${money(premium)})`;
        document.querySelector('#key-ticker').textContent = ticker;
        document.querySelector('#key-lower').textContent = money(lower);
        document.querySelector('#key-upper').textContent = money(upper);
        document.querySelector('#key-premium').textContent = money(premium);
        document.querySelector('#key-breakeven').textContent = money(breakeven);
        document.querySelector('#key-max-loss').textContent = strategy.maxLoss;
        document.querySelector('#key-cap').textContent = strategy.cap;

        const prices = Array.from({ length: 18 }, (_, i) => spot * 0.7 + (spot * 0.6 * i) / 17);
        const values = prices.map((price) => payoffAt(price, strategy, lower, upper, premium));
        const minY = Math.min(...values, 0);
        const maxY = Math.max(...values, premium, 1);
        const sx = (price) => 54 + ((price - spot * 0.7) / (spot * 0.6)) * 652;
        const sy = (value) => 252 - ((value - minY) / Math.max(1, maxY - minY)) * 218;
        document.querySelector('#payoff-line').setAttribute('points', prices.map((price, index) => `${sx(price).toFixed(1)},${sy(values[index]).toFixed(1)}`).join(' '));
        document.querySelector('#scenario-down').textContent = money(payoffAt(spot * 0.8, strategy, lower, upper, premium));
        document.querySelector('#scenario-spot').textContent = money(payoffAt(spot, strategy, lower, upper, premium));
        document.querySelector('#scenario-be').textContent = money(breakeven);
        document.querySelector('#scenario-up').textContent = money(payoffAt(spot * 1.3, strategy, lower, upper, premium));
        document.querySelector('#chart-left').textContent = money(spot * 0.7);
        document.querySelector('#chart-right').textContent = money(spot * 1.3);
        document.querySelector('#chart-breakeven').textContent = `Breakeven ${money(breakeven)}`;
      }

      document.querySelectorAll('.strategy-button').forEach((button) => button.addEventListener('click', () => updateStrategy(button.dataset.strategy)));
      document.querySelectorAll('.ticker-chip').forEach((button) => button.addEventListener('click', () => { tickerInput.value = button.dataset.ticker; draw(); }));
      document.querySelector('#ticker-apply').addEventListener('click', draw);
      [tickerInput, spotRange, lowerRange, upperRange, premiumRange].forEach((input) => input.addEventListener('input', draw));
      draw();
    </script>
  </body>
</html>
